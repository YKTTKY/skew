# Clerk — Retail Trader auth (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional path overrides (defaults work with App Router routes under /sign-in and /sign-up)
